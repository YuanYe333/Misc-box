    {
      "id": "setup",
      "category": "env",
      "name": "环境自检",
      "name_en": "MiscBox Setup",
      "version": "1.0.0",
      "type": "internal",
      "path": "_box/setup.ps1",
      "launch": {
        "kind": "powershell",
        "target": "_box/setup.ps1",
        "args": [],
        "workdir": "_box"
      },
      "summary": "一键探测本机运行时与全部工具是否就绪，输出红黄绿清单并生成环境报告。",
      "when": "第一次使用工具箱、换电脑、重装系统、或某个工具突然打不开时。",
      "usage": [
        {
          "title": "图形方式",
          "steps": [
            "双击 _box\\启动器.bat",
            "左侧点「环境配置」→ 卡片「环境自检」→「打开工具」",
            "或直接双击 _box\\检查环境.bat"
          ]
        },
        {
          "title": "命令行",
          "code": "powershell -NoProfile -ExecutionPolicy Bypass -File \"D:\\杂项工具\\_box\\setup.ps1\""
        }
      ],
      "params": [
        {
          "flag": "-Fix",
          "desc": "对可自动补齐的缺失项执行安装（会逐项询问）"
        },
        {
          "flag": "-Json",
          "desc": "以 JSON 输出，便于脚本消费"
        },
        {
          "flag": "-Quiet",
          "desc": "只输出问题项，不打印全量清单"
        }
      ],
      "pitfalls": [
        "本机 PowerShell 执行策略较严，.ps1 需用 -ExecutionPolicy Bypass 运行",
        "脚本正文含中文时务必保存为 UTF-8 with BOM，否则 PS 5.1 按 GBK 读会报语法错误",
        "pip 自我升级（pip install --upgrade pip）在本机曾出现长时间空转，建议跳过"
      ],
      "next": [
        "code",
        "stego"
      ]
    },
    {
