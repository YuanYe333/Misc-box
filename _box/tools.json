        {
          "title": "3.14（主运行时，含 Pillow）",
          "code": "C:\\Users\\1\\AppData\\Local\\Python\\pythoncore-3.14-64\\python.exe -X utf8 脚本.py"
        },
        {
          "title": "3.12（D:\\websec\\python，供 binwalk/volatility3/theHarvester 虚拟环境）",
          "code": "D:\\websec\\python\\python.exe -V"
        }
      ],
      "params": [],
      "pitfalls": [
        "调用 Python 脚本务必加 -X utf8，否则中文路径与中文输出会乱码",
        "不要把 binwalk 装进系统 Python，它有自己的独立虚拟环境"
      ],
      "next": []
