    {
      "id": "7zip",
      "category": "archive",
      "name": "7-Zip",
      "name_en": "7-Zip",
      "version": "26.03（系统）/ 24.09（便携）",
      "type": "cli-gui",
      "path": "CTF-tools/7zip/7z.exe",
      "alt_paths": [
        "C:/Program Files/7-Zip/7z.exe"
      ],
      "launch": {
        "kind": "dir",
        "target": "CTF-tools/7zip"
      },
      "summary": "解压/打包 zip、7z、rar、tar；处理伪加密、分卷、嵌套压缩包。",
      "when": "拿到压缩包第一步永远是 `7z l` 看结构，而不是直接解压。",
      "usage": [
        {
          "title": "列目录（不解压）",
          "code": "7z l 题目.zip"
        },
        {
          "title": "解压到指定目录",
          "code": "7z x 题目.zip -o输出"
        },
        {
          "title": "带密码解压",
          "code": "7z x -p密码 题目.zip"
        },
        {
          "title": "测试完整性",
          "code": "7z t 题目.zip"
        },
        {
          "title": "只解某个文件",
          "code": "7z x 题目.zip flag.txt"
        },
        {
          "title": "查看是否加密（伪加密判断）",
          "code": "7z l -slt 题目.zip | findstr /i \"Encrypted Method\""
        }
      ],
      "params": [
        {
          "flag": "l",
          "desc": "列出内容（含 CRC、加密标记）"
        },
        {
          "flag": "x",
          "desc": "解压并保留目录结构"
        },
        {
          "flag": "e",
          "desc": "解压到当前目录（丢弃路径）"
        },
        {
          "flag": "t",
          "desc": "完整性测试"
        },
        {
          "flag": "-p",
          "desc": "指定密码，-p 后直接跟密码"
        },
        {
          "flag": "-o",
          "desc": "指定输出目录（注意 -o 后无空格）"
        },
        {
          "flag": "-slt",
          "desc": "技术信息详细列表"
        }
      ],
      "pitfalls": [
        "-o 与路径之间不能有空格：-o输出 而非 -o 输出",
        "中文密码/中文路径在命令行下需 UTF-8 控制台，建议用 Windows Terminal",
        "CTF-tools/7zip 是 24.09 便携副本，系统另有 26.03，两者都能用"
      ],
      "next": [
        "archpr",
        "john",
        "hashcat"
      ]
    },
    {
      "id": "archpr",
      "category": "archive",
      "name": "ARCHPR",
      "name_en": "Advanced Archive Password Recovery",
      "version": "4.66",
      "type": "gui",
      "path": "ARCHPR/ARCHPR.loader.exe",
      "launch": {
        "kind": "exe",
        "target": "ARCHPR/ARCHPR.loader.exe",
        "workdir": "ARCHPR"
      },
      "summary": "压缩包口令恢复：字典/掩码/暴力/明文攻击，图形界面直接选包。",
      "when": "压缩包有密码且字典可能命中时；不想折腾 hashcat 提取哈希就用它。",
      "usage": [
        {
          "title": "图形方式",
          "steps": [
            "双击 ARCHPR/ARCHPR.loader.exe",
            "「打开」选压缩包 → 选「暴力」或「字典」",
            "字典选 ARCHPR/dict/ 下的弱口令/拼音/键盘序，或根目录 dict.txt",
            "「开始」等待结果"
          ]
        }
      ],
      "params": [
        {
          "flag": "字典攻击",
          "desc": "按字典逐条尝试，最快"
        },
        {
          "flag": "掩码攻击",
          "desc": "已知格式（如 4 位数字）时极快"
        },
        {
          "flag": "暴力攻击",
          "desc": "穷举所有组合，慢但保证覆盖"
        },
        {
          "flag": "明文攻击",
          "desc": "已知包内某文件明文时可秒破 ZIP"
        }
      ],
      "pitfalls": [
        "本机这份是绿化版，目录内有历史 CrashLog，若启动崩溃可改用 hashcat 路线",
        "中文界面：Options → Language → chinese_simp.lng",
        "商业软件，仅限自有题目与授权场景；不要公开分发"
      ],
      "next": [
        "john",
        "hashcat"
      ]
    },
    {
      "id": "john",
      "category": "archive",
      "name": "John the Ripper",
      "name_en": "John the Ripper jumbo",
      "version": "1.9.0-jumbo-1",
      "type": "cli",
      "path": "john/john-1.9.0-jumbo-1-win64/run/john.exe",
      "launch": {
        "kind": "dir",
        "target": "john/john-1.9.0-jumbo-1-win64/run"
      },
      "summary": "提供 zip2john / rar2john / 7z2john 等哈希提取器，把加密压缩包转成 hashcat 能吃的哈希。",
      "when": "要用 GPU（hashcat）跑压缩包口令时，先用它提取哈希。",
      "usage": [
        {
          "title": "ZIP → 哈希",
          "code": "cd D:\\杂项工具\\john\\john-1.9.0-jumbo-1-win64\\run\n.\\zip2john.exe D:\\work\\secret.zip > h.txt"
        },
        {
          "title": "RAR → 哈希",
          "code": ".\\rar2john.exe D:\\work\\secret.rar > h.txt"
        },
        {
          "title": "7z → 哈希（需 Perl，见 perl 条目）",
          "code": "perl 7z2john.pl D:\\work\\secret.7z > h.txt"
        }
      ],
      "params": [
        {
          "flag": "zip2john",
          "desc": "ZIP 提取（deflate/store 都支持）"
        },
        {
          "flag": "rar2john",
          "desc": "RAR3/RAR5 提取"
        },
        {
          "flag": "7z2john.pl",
          "desc": "7z 提取，Perl 脚本"
        },
        {
          "flag": "office2john.py",
          "desc": "Office 文档提取"
        },
        {
          "flag": "pdf2john.pl",
          "desc": "PDF 提取"
        }
      ],
      "pitfalls": [
        "zip2john 是 cygwin 编译，不支持中文路径，先复制到纯 ASCII 目录（如 D:\\work）",
        "7z2john.pl 需要 Perl 且 PATH 要含 perl/bin，见工具箱 perl 条目",
        "--potfile-path 传绝对路径会 Permission denied，用默认或相对路径"
      ],
      "next": [
        "hashcat",
        "perl"
      ]
    },
    {
      "id": "hashcat",
      "category": "archive",
      "name": "hashcat",
      "name_en": "hashcat",
      "version": "7.1.2",
      "type": "cli",
      "path": "hashcat/hashcat.exe",
      "launch": {
        "kind": "dir",
        "target": "hashcat"
      },
      "summary": "GPU 口令爆破：字典/掩码/规则/组合，支持 300+ 哈希类型。",
      "when": "压缩包、Office、PDF、系统哈希等需要高速爆破时；本机 RTX 5060 实测 MD5 约 17345 MH/s。",
      "usage": [
        {
          "title": "字典攻击（最常用）",
          "code": "cd D:\\杂项工具\\hashcat\n.\\hashcat.exe -m 0 -a 0 hash.txt 字典.txt"
        },
        {
          "title": "掩码爆破",
          "code": ".\\hashcat.exe -m 0 -a 3 hash.txt ?a?a?a?a?a?a"
        },
        {
          "title": "字典 + 规则变形",
          "code": ".\\hashcat.exe -m 0 -a 0 hash.txt 字典.txt -r rules\\best66.rule"
        },
        {
          "title": "字典 + 掩码混合",
          "code": ".\\hashcat.exe -m 0 -a 6 hash.txt 字典.txt ?d?d"
        },
        {
          "title": "逐位加长",
          "code": ".\\hashcat.exe -m 0 -a 3 hash.txt ?a?a?a?a?a?a?a?a --increment --increment-min 1"
        },
        {
          "title": "查看结果",
          "code": ".\\hashcat.exe -m 0 hash.txt --show"
        },
        {
          "title": "查哈希类型编号",
          "code": ".\\hashcat.exe -m 17200 --example-hashes"
        }
      ],
      "params": [
        {
          "flag": "-m",
          "desc": "哈希类型：0=MD5 100=SHA1 1400=SHA256 17200=PKZIP 17210=PKZIP-store 13000=RAR5 23700=RAR3 11600=7-Zip 10500=PDF"
        },
        {
          "flag": "-a",
          "desc": "攻击模式：0=字典 1=组合 3=掩码 6=字典+掩码 7=掩码+字典"
        },
        {
          "flag": "--show / --left",
          "desc": "查看已破解 / 未破解"
        },
        {
          "flag": "--increment",
          "desc": "掩码逐位加长"
        },
        {
          "flag": "-O",
          "desc": "优化内核，更快但密码长度受限（≤31）"
        },
        {
          "flag": "-w",
          "desc": "工作负载 1~4（默认 2，3 更激进）"
        },
        {
          "flag": "-D 1",
          "desc": "只用 GPU"
        },
        {
          "flag": "--runtime",
          "desc": "限时秒数后自动停止"
        },
        {
          "flag": "--session + --restore",
          "desc": "长任务断点续跑"
        }
      ],
      "pitfalls": [
        "必须在 hashcat 目录下运行，否则找不到 OpenCL/",
        "hashcat 不能直接吃 .zip/.rar，必须先用 john 提取哈希",
        "PKZIP deflate 用 17200，store 用 17210，选反会报 unsupported compression type",
        "启动打印 CUDA SDK Toolkit not installed 并回退 OpenCL 属正常现象",
        "--potfile-path 绝对路径在 Windows 版有 Permission denied 的 bug"
      ],
      "next": [
        "john",
        "hashcat-panel"
      ]
    },
